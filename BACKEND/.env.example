# ─── Database ────────────────────────────────────────────
MONGO_URI=mongodb://your_user:your_password@localhost:27017
DB_NAME=Drivya

# ─── JWT Secrets (generate strong random secrets) ───────
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_SHARE_SECRET=your_jwt_share_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
SHARE_ACCESS_TOKEN_EXPIRY=1h

# ─── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS & Public Domain ────────────────────────────────
CORS_ORIGIN=http://localhost:5173
PUBLIC_SHARE_BASE_URL=https://drivya.link

# ─── Security & Admin ────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
TWOFA_ENCRYPTION_KEY=your_base64_32byte_encryption_key
ADMIN_EMAIL=admin@example.com

# ─── Google OAuth (Drive Export & Login) ──────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/auth/google/login/callback

# ─── Dropbox OAuth (Dropbox Import) ─────────────────────
DROPBOX_CLIENT_ID=your_dropbox_client_id
DROPBOX_CLIENT_SECRET=your_dropbox_client_secret
DROPBOX_REDIRECT_URI=http://localhost:3000/auth/dropbox/callback

# ─── GitHub OAuth (GitHub Login) ─────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# ─── AI Integration ─────────────────────────────────────
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key
AI_MODEL=gemini-2.5-flash
# AI_BASE_URL=https://api.openai.com/v1

# ─── Redis (Cloud / Local) ───────────────────────────────
# Option 1: Standard Redis URL (overrides individual vars below)
# REDIS_URL=rediss://default:your_password@your-host:6380
# Option 2: Individual vars (used when REDIS_URL is not set)
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Razorpay Payment & Billing ───────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay Plan IDs (run: node scripts/seedRazorpayPlans.js)
RZP_PLAN_SPARK_GO_MONTHLY=
RZP_PLAN_SPARK_GO_YEARLY=
RZP_PLAN_BOOST_MONTHLY=
RZP_PLAN_BOOST_YEARLY=
RZP_PLAN_PRO_MONTHLY=
RZP_PLAN_PRO_YEARLY=
RZP_PLAN_APEX_MONTHLY=
RZP_PLAN_APEX_YEARLY=

# ─── Mailer / Email Notifications (Optional SMTP) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Upload Cap Limits ──────────────────────────────────
MAX_FILE_SIZE=53687091200
MAX_FILES_PER_REQUEST=10

# ─── Scheduled Background Jobs (Cron) ───────────────────
TRASH_CRON_SCHEDULE=0 2 * * *
BANDWIDTH_RESET_CRON_SCHEDULE=0 3 1 * *
